# Script-mode helper: turns a list of compiled shaders into one C++ header of
# std::uint32_t SPIR-V words, so the binary never loads shader files at run
# time.
#
#   cmake -DSHADER_DIR=... -DOUTPUT=... -DSHADERS=a,b,c -P embed_spirv.cmake

if(NOT SHADER_DIR OR NOT OUTPUT OR NOT SHADERS)
  message(FATAL_ERROR "embed_spirv.cmake needs SHADER_DIR, OUTPUT and SHADERS")
endif()

string(REPLACE "," ";" names "${SHADERS}")
set(content "// Generated by cmake/embed_spirv.cmake; do not edit.\n#pragma once\n\n#include <cstddef>\n#include <cstdint>\n\nnamespace vqm::internal::shaders {\n\n")
foreach(name IN LISTS names)
  file(READ "${SHADER_DIR}/${name}.spv" hex HEX)
  string(LENGTH "${hex}" hex_length)
  math(EXPR remainder "${hex_length} % 8")
  if(remainder)
    message(FATAL_ERROR "${name}.spv is not a whole number of words")
  endif()
  # Little-endian: reverse each 4-byte group into one uint32_t literal.
  string(REGEX REPLACE "([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])" "0x\\4\\3\\2\\1," words "${hex}")
  string(APPEND content "inline constexpr std::uint32_t ${name}_spv[] = {${words}};\n\n")
endforeach()
string(APPEND content "struct Blob {\n    const char* name;\n    const std::uint32_t* words;\n    std::size_t word_count;\n};\n\ninline constexpr Blob kBlobs[] = {\n")
foreach(name IN LISTS names)
  string(APPEND content "    {\"${name}\", ${name}_spv, sizeof(${name}_spv) / sizeof(${name}_spv[0])},\n")
endforeach()
string(APPEND content "};\n\n}  // namespace vqm::internal::shaders\n")

file(WRITE "${OUTPUT}.tmp" "${content}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different
                "${OUTPUT}.tmp" "${OUTPUT}")
file(REMOVE "${OUTPUT}.tmp")
