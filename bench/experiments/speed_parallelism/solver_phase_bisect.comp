// Research decomposition of the maintained Sturm solver. Each subgroup owns
// one rank and evaluates five baseline binary decisions through 31 trial nodes.
#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#include "vmaf_speed_stats_common.glsl"
layout(local_size_x = 32) in;
shared float diagonal[25], subdiagonal[25];

uint sturm_count(float x) {
    uint count = 0u;
    float pivot = diagonal[0] - x;
    if (isnan(pivot)) return 26u;
    if (abs(pivot) < 1e-37) pivot = pivot < 0.0 ? -1e-37 : 1e-37;
    if (pivot < 0.0) ++count;
    for (uint i = 1u; i < 25u; ++i) {
        float edge = subdiagonal[i - 1u];
        pivot = diagonal[i] - x - edge * (edge / pivot);
        if (isnan(pivot)) return 26u;
        if (abs(pivot) < 1e-37) pivot = pivot < 0.0 ? -1e-37 : 1e-37;
        if (pivot < 0.0) ++count;
    }
    return count;
}

void main() {
    uint rank = gl_WorkGroupID.x, ch = gl_WorkGroupID.y;
    uint lane = gl_LocalInvocationIndex;
    uint aux = pc.scratch + 2604u * pc.op + 56u * ch;
    // The prototype requires one complete native 32-lane subgroup per group.
    // A malformed/invalid prepared system is sent to the unchanged fallback.
    if (arena[aux + 51u] != 0.0 || arena[aux + 52u] != 0.0) {
        if (lane == 0u) arena[eigen(ch, rank)] = uintBitsToFloat(0x7fc00000u);
        return;
    }
    if (lane < 25u) diagonal[lane] = arena[aux + lane];
    if (lane < 24u) subdiagonal[lane] = arena[aux + 25u + lane];
    barrier();
    float lo = arena[aux + 49u], hi = arena[aux + 50u];
    bool converged = false, invalid = false;
    uint iterations = 0u;
    for (uint batch = 0u; batch < 64u; ++batch) {
        // Breadth-first binary-tree node 1..31 has at most four ancestors.
        // Repeated FP32 midpoint expressions reproduce each node's actual
        // baseline endpoints; equally spaced interpolation would not.
        float trial = 0.0;
        uint count = 0u;
        if (lane < 31u) {
            uint node = lane + 1u;
            uint depth = uint(findMSB(node));
            uint path = node - (1u << depth);
            float trial_lo = lo, trial_hi = hi;
            for (uint step = 0u; step < depth; ++step) {
                float mid = trial_lo * 0.5 + trial_hi * 0.5;
                uint direction = (path >> (depth - 1u - step)) & 1u;
                if (direction == 0u)
                    trial_hi = mid;
                else
                    trial_lo = mid;
            }
            trial = trial_lo * 0.5 + trial_hi * 0.5;
            count = sturm_count(trial);
        }
        uint selected = 1u;
        for (uint level = 0u; level < 5u; ++level) {
            // All lanes follow the same rank/interval and request the same
            // live node; invalid unused speculative nodes do not affect it.
            float mid = subgroupShuffle(trial, selected - 1u);
            uint actual_count = subgroupShuffle(count, selected - 1u);
            ++iterations;
            if (mid == lo || mid == hi) {
                converged = true;
                break;
            }
            if (actual_count > 25u) {
                invalid = true;
                break;
            }
            if (actual_count <= rank) {
                lo = mid;
                selected = 2u * selected + 1u;
            } else {
                hi = mid;
                selected = 2u * selected;
            }
        }
        if (converged || invalid || iterations == 320u) break;
    }
    if (lane == 0u) {
        float value = lo * 0.5 + hi * 0.5;
        // A failed rank must select the legacy QR path even if its last
        // midpoint happened to be finite. The finish pass consumes this marker
        // before pooling; QR overwrites the entire spectrum on failure.
        arena[eigen(ch, rank)] =
            converged && !invalid && !isnan(value) && !isinf(value)
                ? value
                : uintBitsToFloat(0x7fc00000u);
    }
}
