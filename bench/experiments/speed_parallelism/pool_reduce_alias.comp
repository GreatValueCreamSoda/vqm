// Reconstruct the original two-level 64-score reduction without reallocating.
#version 450
#include "vmaf_speed_stats_common.glsl"
layout(local_size_x = 64) in;
shared float partial[64];
shared float old_groups[21];  // ceil(1300 / 64), the alias path's upper bound.
void main() {
    uint lane = gl_LocalInvocationIndex, channel = gl_WorkGroupID.x;
    uint blocks = (pc.width / 5u) * (pc.height / 5u);
    for (uint group = 0u; group < pc.groups; ++group) {
        uint block = group * 64u + lane;
        partial[lane] =
            block < blocks ? arena[bank(2u * channel) + kMeans + block] : 0.0;
        barrier();
        for (uint step = 32u; step > 0u; step >>= 1u) {
            if (lane < step) partial[lane] += partial[lane + step];
            barrier();
        }
        if (lane == 0u) old_groups[group] = partial[0];
        barrier();
    }
    // The original reduce starts each lane at zero and adds its strided
    // original-group partials, then executes the same halving ladder.
    float total = 0.0;
    for (uint group = lane; group < pc.groups; group += 64u)
        total += old_groups[group];
    partial[lane] = total;
    barrier();
    for (uint step = 32u; step > 0u; step >>= 1u) {
        if (lane < step) partial[lane] += partial[lane + step];
        barrier();
    }
    if (lane == 0u) {
        arena[pc.result + 2u * channel] = partial[0] / float(blocks);
        arena[pc.result + 2u * channel + 1u] =
            max(status(2u * channel), status(2u * channel + 1u));
    }
}
