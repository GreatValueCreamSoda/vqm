// Merge externally stored block scores with the original 64-score add tree.
#version 450
#include "vmaf_speed_stats_common.glsl"
layout(local_size_x = 64) in;
shared float partial[64];
void main() {
    uint lane = gl_LocalInvocationIndex;
    uint block = gl_WorkGroupID.x * 64u + lane;
    uint channel = gl_WorkGroupID.y;
    uint blocks = (pc.width / 5u) * (pc.height / 5u);
    partial[lane] =
        block < blocks ? arena[pc.partials + channel * blocks + block] : 0.0;
    barrier();
    for (uint step = 32u; step > 0u; step >>= 1u) {
        if (lane < step) partial[lane] += partial[lane + step];
        barrier();
    }
    // pc.op is the U/V channel count only for this experimental merge pass.
    if (lane == 0u)
        arena
            [pc.partials + pc.op * blocks + channel * pc.groups +
             gl_WorkGroupID.x] = partial[0];
}
