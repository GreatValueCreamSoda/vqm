// Research-only observation of the ordinary 16x16 compute pipeline. No timers.
#version 450
#extension GL_KHR_shader_subgroup_basic : require

layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) buffer Output { uint words[]; };

void main() {
    if (gl_LocalInvocationIndex == 0u) {
        words[0] = gl_SubgroupSize;
        words[1] = gl_NumSubgroups;
        words[2] = gl_WorkGroupSize.x * gl_WorkGroupSize.y;
        words[3] = uint(gl_SubgroupSize == 32u && gl_NumSubgroups == 8u);
    }
    // Distinct physical invocations publish to distinct words. The host checks
    // whether the subgroup-based logical ordering covers all256 slots exactly.
    words[4u + gl_LocalInvocationIndex] =
        gl_SubgroupID * gl_SubgroupSize + gl_SubgroupInvocationID;
}
