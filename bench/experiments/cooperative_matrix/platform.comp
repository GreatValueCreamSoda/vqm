#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#pragma use_vulkan_memory_model

#ifndef MATRIX_M
#define MATRIX_M 16
#endif
#ifndef MATRIX_N
#define MATRIX_N 16
#endif
#ifndef MATRIX_K
#define MATRIX_K 16
#endif
layout(local_size_x = 32) in;
layout(std430, set = 0, binding = 0) readonly buffer Input { float data[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Output { float result[]; };
shared float16_t a[MATRIX_M * MATRIX_K];
shared float16_t b[MATRIX_K * MATRIX_N];

void main() {
    uint lane = gl_LocalInvocationID.x;
    for (uint i = lane; i < MATRIX_M * MATRIX_K; i += 32u)
        a[i] = float16_t(data[i]);
    for (uint i = lane; i < MATRIX_K * MATRIX_N; i += 32u)
        b[i] = float16_t(data[MATRIX_M * MATRIX_K + i]);
    barrier();
    coopmat<float16_t, gl_ScopeSubgroup, MATRIX_M, MATRIX_K, gl_MatrixUseA> left;
    coopmat<float16_t, gl_ScopeSubgroup, MATRIX_K, MATRIX_N, gl_MatrixUseB>
        right;
    coopmat<float, gl_ScopeSubgroup, MATRIX_M, MATRIX_N, gl_MatrixUseAccumulator>
        sum = coopmat<
            float, gl_ScopeSubgroup, MATRIX_M, MATRIX_N,
            gl_MatrixUseAccumulator>(0.0);
    coopMatLoad(left, a, 0u, MATRIX_K, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(right, b, 0u, MATRIX_N, gl_CooperativeMatrixLayoutRowMajor);
    sum = coopMatMulAdd(left, right, sum);
    coopMatStore(sum, result, 0u, MATRIX_N, gl_CooperativeMatrixLayoutRowMajor);
}
