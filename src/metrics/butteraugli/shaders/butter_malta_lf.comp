// The 5-tap Malta unit (MaltaUnit<MaltaTagLF>, butteraugli.cc:579-750) used by
// the HF and MF bands. Same geometry and scaled-diffs prologue as
// butter_malta.comp; the line terms are five taps each and there are no
// duplicated lines (Compare with the source's 16 terms: they are all distinct).
// z selects the band: 0 = Y (plane 1, ac channel 1), 1 = X (plane 0, ac 0),
// in libjxl's order (:1916-1928 HF Y, HF X, MF Y, MF X).

#version 450

#include "butter_common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

const uint kTile = 32u;
const uint kHalo = 4u;
const uint kWin = kTile + 2u * kHalo;  // 40

shared float window0[kWin * kWin];
shared float window1[kWin * kWin];
shared float diffs[kWin * kWin];

float sum4(float a, float b, float c, float d) { return (a + b) + (c + d); }
float sum5(float a, float b, float c, float d, float e) {
    return sum4(a, b, c, d + e);
}

float tap(int cy, int cx, int dy, int dx) {
    return diffs[uint((cy + dy) * int(kWin) + (cx + dx))];
}

// MaltaUnit<MaltaTagLF>, 16 line terms of five taps, libjxl's order.
float unit(int cy, int cx) {
    float total = sum5(
        tap(cy, cx, 0, -4), tap(cy, cx, 0, -2), tap(cy, cx, 0, 0),
        tap(cy, cx, 0, 2), tap(cy, cx, 0, 4)
    );
    total *= total;
    float line = sum5(
        tap(cy, cx, -4, 0), tap(cy, cx, -2, 0), tap(cy, cx, 0, 0),
        tap(cy, cx, 2, 0), tap(cy, cx, 4, 0)
    );
    total += line * line;
    line = sum5(
        tap(cy, cx, -3, -3), tap(cy, cx, -2, -2), tap(cy, cx, 0, 0),
        tap(cy, cx, 2, 2), tap(cy, cx, 3, 3)
    );
    total += line * line;
    line = sum5(
        tap(cy, cx, -3, 3), tap(cy, cx, -2, 2), tap(cy, cx, 0, 0),
        tap(cy, cx, 2, -2), tap(cy, cx, 3, -3)
    );
    total += line * line;
    line = sum5(
        tap(cy, cx, -4, -1), tap(cy, cx, -2, -1), tap(cy, cx, 0, 0),
        tap(cy, cx, 2, 1), tap(cy, cx, 4, 1)
    );
    total += line * line;
    line = sum5(
        tap(cy, cx, -4, 1), tap(cy, cx, -2, 1), tap(cy, cx, 0, 0),
        tap(cy, cx, 2, -1), tap(cy, cx, 4, -1)
    );
    total += line * line;
    line = sum5(
        tap(cy, cx, -1, -4), tap(cy, cx, -1, -2), tap(cy, cx, 0, 0),
        tap(cy, cx, 1, 2), tap(cy, cx, 1, 4)
    );
    total += line * line;
    line = sum5(
        tap(cy, cx, 1, -4), tap(cy, cx, 1, -2), tap(cy, cx, 0, 0),
        tap(cy, cx, -1, 2), tap(cy, cx, -1, 4)
    );
    total += line * line;
    line = sum5(
        tap(cy, cx, -3, -2), tap(cy, cx, -2, -1), tap(cy, cx, 0, 0),
        tap(cy, cx, 2, 1), tap(cy, cx, 3, 2)
    );
    total += line * line;
    line = sum5(
        tap(cy, cx, -3, 2), tap(cy, cx, -2, 1), tap(cy, cx, 0, 0),
        tap(cy, cx, 2, -1), tap(cy, cx, 3, -2)
    );
    total += line * line;
    line = sum5(
        tap(cy, cx, -2, -3), tap(cy, cx, -1, -2), tap(cy, cx, 0, 0),
        tap(cy, cx, 1, 2), tap(cy, cx, 2, 3)
    );
    total += line * line;
    line = sum5(
        tap(cy, cx, -2, 3), tap(cy, cx, -1, 2), tap(cy, cx, 0, 0),
        tap(cy, cx, 1, -2), tap(cy, cx, 2, -3)
    );
    total += line * line;
    line = sum5(
        tap(cy, cx, 2, -4), tap(cy, cx, 1, -2), tap(cy, cx, 0, 0),
        tap(cy, cx, -1, 2), tap(cy, cx, -2, 4)
    );
    total += line * line;
    line = sum5(
        tap(cy, cx, -2, -4), tap(cy, cx, -1, -2), tap(cy, cx, 0, 0),
        tap(cy, cx, 1, 2), tap(cy, cx, 2, 4)
    );
    total += line * line;
    line = sum5(
        tap(cy, cx, -4, -2), tap(cy, cx, -2, -1), tap(cy, cx, 0, 0),
        tap(cy, cx, 2, 1), tap(cy, cx, 4, 2)
    );
    total += line * line;
    line = sum5(
        tap(cy, cx, -4, 2), tap(cy, cx, -2, 1), tap(cy, cx, 0, 0),
        tap(cy, cx, 2, -1), tap(cy, cx, 4, -2)
    );
    total += line * line;
    return total;
}

void main() {
    const uint tid = gl_LocalInvocationIndex;
    const uint width = butter_width();
    const uint height = butter_height();
    const uint area = butter_area();
    const uint x0 = gl_WorkGroupID.x * kTile;
    const uint y0 = gl_WorkGroupID.y * kTile;
    const uint z = gl_WorkGroupID.z;
    const uint plane = z == 0u ? 1u : 0u;
    const uint channel = plane;

    const uint lum0 = pc.a + plane * area;
    const uint lum1 = pc.b + plane * area;
    const uint ac = butter_here(R_AC) + channel * area;

    for (uint i = tid; i < kWin * kWin; i += 256u) {
        const uint r = i / kWin;
        const uint c = i % kWin;
        const int gx = int(x0) + int(c) - int(kHalo);
        const int gy = int(y0) + int(r) - int(kHalo);
        float v0 = 0.0;
        float v1 = 0.0;
        if (gx >= 0 && uint(gx) < width && gy >= 0 && uint(gy) < height) {
            const uint index = uint(gy) * width + uint(gx);
            v0 = arena[lum0 + index];
            v1 = arena[lum1 + index];
        }
        window0[i] = v0;
        window1[i] = v1;
    }
    barrier();

    // Band prefactors: band 0 (Y) in p0..p2, band 1 (X) in q0..q2.
    const float norm2_gt1 = z == 0u ? pc.p0 : pc.q0;
    const float norm2_lt1 = z == 0u ? pc.p1 : pc.q1;
    const float norm1 = z == 0u ? pc.p2 : pc.q2;
    for (uint i = tid; i < kWin * kWin; i += 256u) {
        const float a = window0[i];
        const float b = window1[i];
        const float absval = 0.5 * (abs(a) + abs(b));
        const float scaler = norm2_gt1 / (norm1 + absval);
        float diff = scaler * (a - b);
        const float scaler2 = norm2_lt1 / (norm1 + absval);
        const float fabs0 = abs(a);
        const float too_small = 0.55 * fabs0;
        const float too_big = 1.05 * fabs0;
        if (a < 0.0) {
            if (b > -too_small) {
                diff -= scaler2 * (b + too_small);
            } else if (b < -too_big) {
                diff += scaler2 * (-b - too_big);
            }
        } else {
            if (b < too_small) {
                diff += scaler2 * (too_small - b);
            } else if (b > too_big) {
                diff -= scaler2 * (b - too_big);
            }
        }
        diffs[i] = diff;
    }
    barrier();

    for (uint i = tid; i < kTile * kTile; i += 256u) {
        const uint x = i % kTile;
        const uint y = i / kTile;
        const uint gx = x0 + x;
        const uint gy = y0 + y;
        if (gx >= width || gy >= height) continue;
        arena[ac + gy * width + gx] +=
            unit(int(y) + int(kHalo), int(x) + int(kHalo));
    }
}
