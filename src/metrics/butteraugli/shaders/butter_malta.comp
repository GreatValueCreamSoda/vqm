// The 16-line Malta unit of the UHF bands (butteraugli.cc:754-949 MaltaUnit).
// One workgroup owns a 32x32 output tile and the 9x9 window each output needs,
// so a 40x40 shared window holds the two luminance planes and their scaled
// difference (MaltaDiffMapT, :988-1107):
//   diffs = scaler * (lum0 - lum1), scaler = norm2_gt1/(norm1 + absval)
//   plus the two half-open objectives scaled by norm2_lt1/(norm1 + absval),
//   everything else in the epilogue of the pointwise part below.
// The unit sums 16 squared line sums; libjxl's last four lines are
// byte-identical duplicates of earlier ones (:882-946) and are kept -- dropping
// them under-weights UHF energy, which is one source of a peer's drift.
// z selects the band: 0 = Y (plane 1, ac channel 1), 1 = X (plane 0, ac 0),
// in libjxl's order (:1910-1915 UHF Y then UHF X).
//
// Cost note, measured: removing the *entire* unit (accumulating the centre diff
// instead) took the stage from 2.82 to 2.59 ms at 4K, so the sixteen line sums
// are ~8% of it and splitting their dependency chain across lanes cannot pay
// for the score movement it would cost. What dominates is the window traffic:
// a 32x32 output tile reads a 40x40 window, 1.56x amplification, and that is
// the only lever left here.

#version 450

#include "butter_common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

const uint kTile = 32u;
const uint kHalo = 4u;
const uint kWin = kTile + 2u * kHalo;  // 40

shared float window0[kWin * kWin];
shared float window1[kWin * kWin];
shared float diffs[kWin * kWin];

float sum4(float a, float b, float c, float d) { return (a + b) + (c + d); }
float sum5(float a, float b, float c, float d, float e) {
    return sum4(a, b, c, d + e);
}
float sum7(float a, float b, float c, float d, float e, float f, float g) {
    return sum4(a, b, c, sum4(d, e, f, g));
}
float sum9(
    float a, float b, float c, float d, float e, float f, float g, float h,
    float i
) {
    return (sum4(a, b, c, d) + sum4(e, f, g, h)) + i;
}

// One tap of the unit, relative to the output pixel's centre (cy, cx) in the
// shared window.
float tap(int cy, int cx, int dy, int dx) {
    return diffs[uint((cy + dy) * int(kWin) + (cx + dx))];
}

// MaltaUnit, 16 line terms, in libjxl's order. Terms 13-16 repeat terms 8, 7,
// 6 and 5 exactly; the duplication is part of the metric.
float unit(int cy, int cx) {
    float total = sum9(
        tap(cy, cx, 0, -4), tap(cy, cx, 0, -3), tap(cy, cx, 0, -2),
        tap(cy, cx, 0, -1), tap(cy, cx, 0, 0), tap(cy, cx, 0, 1),
        tap(cy, cx, 0, 2), tap(cy, cx, 0, 3), tap(cy, cx, 0, 4)
    );
    total *= total;
    float line = sum9(
        tap(cy, cx, -4, 0), tap(cy, cx, -3, 0), tap(cy, cx, -2, 0),
        tap(cy, cx, -1, 0), tap(cy, cx, 0, 0), tap(cy, cx, 1, 0),
        tap(cy, cx, 2, 0), tap(cy, cx, 3, 0), tap(cy, cx, 4, 0)
    );
    total += line * line;
    line = sum7(
        tap(cy, cx, -3, -3), tap(cy, cx, -2, -2), tap(cy, cx, -1, -1),
        tap(cy, cx, 0, 0), tap(cy, cx, 1, 1), tap(cy, cx, 2, 2),
        tap(cy, cx, 3, 3)
    );
    total += line * line;
    line = sum7(
        tap(cy, cx, -3, 3), tap(cy, cx, -2, 2), tap(cy, cx, -1, 1),
        tap(cy, cx, 0, 0), tap(cy, cx, 1, -1), tap(cy, cx, 2, -2),
        tap(cy, cx, 3, -3)
    );
    total += line * line;
    line = sum9(
        tap(cy, cx, -4, 1), tap(cy, cx, -3, 1), tap(cy, cx, -2, 1),
        tap(cy, cx, -1, 0), tap(cy, cx, 0, 0), tap(cy, cx, 1, 0),
        tap(cy, cx, 2, -1), tap(cy, cx, 3, -1), tap(cy, cx, 4, -1)
    );
    total += line * line;
    line = sum9(
        tap(cy, cx, -4, -1), tap(cy, cx, -3, -1), tap(cy, cx, -2, -1),
        tap(cy, cx, -1, 0), tap(cy, cx, 0, 0), tap(cy, cx, 1, 0),
        tap(cy, cx, 2, 1), tap(cy, cx, 3, 1), tap(cy, cx, 4, 1)
    );
    total += line * line;
    line = sum9(
        tap(cy, cx, -1, -4), tap(cy, cx, -1, -3), tap(cy, cx, -1, -2),
        tap(cy, cx, 0, -1), tap(cy, cx, 0, 0), tap(cy, cx, 0, 1),
        tap(cy, cx, 1, 2), tap(cy, cx, 1, 3), tap(cy, cx, 1, 4)
    );
    total += line * line;
    line = sum9(
        tap(cy, cx, 1, -4), tap(cy, cx, 1, -3), tap(cy, cx, 1, -2),
        tap(cy, cx, 0, -1), tap(cy, cx, 0, 0), tap(cy, cx, 0, 1),
        tap(cy, cx, -1, 2), tap(cy, cx, -1, 3), tap(cy, cx, -1, 4)
    );
    total += line * line;
    line = sum7(
        tap(cy, cx, -3, -2), tap(cy, cx, -2, -1), tap(cy, cx, -1, -1),
        tap(cy, cx, 0, 0), tap(cy, cx, 1, 1), tap(cy, cx, 2, 1),
        tap(cy, cx, 3, 2)
    );
    total += line * line;
    line = sum7(
        tap(cy, cx, -3, 2), tap(cy, cx, -2, 1), tap(cy, cx, -1, 1),
        tap(cy, cx, 0, 0), tap(cy, cx, 1, -1), tap(cy, cx, 2, -1),
        tap(cy, cx, 3, -2)
    );
    total += line * line;
    line = sum7(
        tap(cy, cx, -2, -3), tap(cy, cx, -1, -2), tap(cy, cx, -1, -1),
        tap(cy, cx, 0, 0), tap(cy, cx, 1, 1), tap(cy, cx, 1, 2),
        tap(cy, cx, 2, 3)
    );
    total += line * line;
    line = sum7(
        tap(cy, cx, -2, 3), tap(cy, cx, -1, 2), tap(cy, cx, -1, 1),
        tap(cy, cx, 0, 0), tap(cy, cx, 1, -1), tap(cy, cx, 1, -2),
        tap(cy, cx, 2, -3)
    );
    total += line * line;
    // Duplicates of terms 8, 7, 6 and 5 (butteraugli.cc:882-946).
    line = sum9(
        tap(cy, cx, 1, -4), tap(cy, cx, 1, -3), tap(cy, cx, 1, -2),
        tap(cy, cx, 0, -1), tap(cy, cx, 0, 0), tap(cy, cx, 0, 1),
        tap(cy, cx, -1, 2), tap(cy, cx, -1, 3), tap(cy, cx, -1, 4)
    );
    total += line * line;
    line = sum9(
        tap(cy, cx, -1, -4), tap(cy, cx, -1, -3), tap(cy, cx, -1, -2),
        tap(cy, cx, 0, -1), tap(cy, cx, 0, 0), tap(cy, cx, 0, 1),
        tap(cy, cx, 1, 2), tap(cy, cx, 1, 3), tap(cy, cx, 1, 4)
    );
    total += line * line;
    line = sum9(
        tap(cy, cx, -4, -1), tap(cy, cx, -3, -1), tap(cy, cx, -2, -1),
        tap(cy, cx, -1, 0), tap(cy, cx, 0, 0), tap(cy, cx, 1, 0),
        tap(cy, cx, 2, 1), tap(cy, cx, 3, 1), tap(cy, cx, 4, 1)
    );
    total += line * line;
    line = sum9(
        tap(cy, cx, -4, 1), tap(cy, cx, -3, 1), tap(cy, cx, -2, 1),
        tap(cy, cx, -1, 0), tap(cy, cx, 0, 0), tap(cy, cx, 1, 0),
        tap(cy, cx, 2, -1), tap(cy, cx, 3, -1), tap(cy, cx, 4, -1)
    );
    total += line * line;
    return total;
}

void main() {
    const uint tid = gl_LocalInvocationIndex;
    const uint width = butter_width();
    const uint height = butter_height();
    const uint area = butter_area();
    const uint x0 = gl_WorkGroupID.x * kTile;
    const uint y0 = gl_WorkGroupID.y * kTile;
    const uint z = gl_WorkGroupID.z;
    // Band 0 is Y, band 1 is X; libjxl resolves the plane through psy.hf/uhf
    // indices (Y = 1, X = 0).
    const uint plane = z == 0u ? 1u : 0u;
    const uint channel = plane;

    const uint lum0 = pc.a + plane * area;
    const uint lum1 = pc.b + plane * area;
    const uint ac = butter_here(R_AC) + channel * area;

    // 1. The 40x40 window of both luminance planes, zero-padded.
    for (uint i = tid; i < kWin * kWin; i += 256u) {
        const uint r = i / kWin;
        const uint c = i % kWin;
        const int gx = int(x0) + int(c) - int(kHalo);
        const int gy = int(y0) + int(r) - int(kHalo);
        float v0 = 0.0;
        float v1 = 0.0;
        if (gx >= 0 && uint(gx) < width && gy >= 0 && uint(gy) < height) {
            const uint index = uint(gy) * width + uint(gx);
            v0 = arena[lum0 + index];
            v1 = arena[lum1 + index];
        }
        window0[i] = v0;
        window1[i] = v1;
    }
    barrier();

    // 2. The scaled diffs (MaltaDiffMapT, :1013-1090). The two secondary
    // objectives are half-open quadratics around the reference's value.
    // Band prefactors: band 0 (Y) arrives in p0..p2, band 1 (X) in q0..q2, so
    // one dispatch covers both bands of a chain.
    const float norm2_gt1 = z == 0u ? pc.p0 : pc.q0;
    const float norm2_lt1 = z == 0u ? pc.p1 : pc.q1;
    const float norm1 = z == 0u ? pc.p2 : pc.q2;
    for (uint i = tid; i < kWin * kWin; i += 256u) {
        const float a = window0[i];
        const float b = window1[i];
        const float absval = 0.5 * (abs(a) + abs(b));
        const float scaler = norm2_gt1 / (norm1 + absval);
        float diff = scaler * (a - b);
        const float scaler2 = norm2_lt1 / (norm1 + absval);
        const float fabs0 = abs(a);
        const float too_small = 0.55 * fabs0;
        const float too_big = 1.05 * fabs0;
        if (a < 0.0) {
            if (b > -too_small) {
                diff -= scaler2 * (b + too_small);
            } else if (b < -too_big) {
                diff += scaler2 * (-b - too_big);
            }
        } else {
            if (b < too_small) {
                diff += scaler2 * (too_small - b);
            } else if (b > too_big) {
                diff -= scaler2 * (b - too_big);
            }
        }
        diffs[i] = diff;
    }
    barrier();

    // 3. One unit per output pixel, accumulated into this band's channel.
    for (uint i = tid; i < kTile * kTile; i += 256u) {
        const uint x = i % kTile;
        const uint y = i / kTile;
        const uint gx = x0 + x;
        const uint gy = y0 + y;
        if (gx >= width || gy >= height) continue;
        const uint index = gy * width + gx;
        arena[ac + index] += unit(int(y) + int(kHalo), int(x) + int(kHalo));
    }
}
