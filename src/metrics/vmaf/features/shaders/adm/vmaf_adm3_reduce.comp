#version 450
#include "vmaf_adm_common.glsl"
layout(local_size_x = 256) in;
shared float sums[9][256];
void main() {
    uint lane = gl_LocalInvocationIndex;
    for (uint c = 0; c < 9; ++c) {
        float v = 0.0;
        for (uint i = lane; i < pc.groups; i += 256)
            v += arena[pc.partials + i * 9 + c];
        sums[c][lane] = v;
    }
    barrier();
    for (uint step = 128; step > 0; step >>= 1) {
        if (lane < step)
            for (uint c = 0; c < 9; ++c) sums[c][lane] += sums[c][lane + step];
        barrier();
    }
    if (lane == 0) {
        int left = (int(pc.width) - 5) / 10;
        int top = (int(pc.height) - 5) / 10;
        float pixels =
            float(int(pc.width) - 2 * left) * float(int(pc.height) - 2 * top);
        float noise = pow(pixels * 0.02, 1.0 / 3.0);
        float num = 0.0, den = 0.0, aim = 0.0;
        for (uint c = 0; c < 3; ++c) {
            num += pow(sums[c][0], 1.0 / 3.0) + noise;
            den += pow(sums[c + 3][0], 1.0 / 3.0) + noise;
            aim += pow(sums[c + 6][0], 1.0 / 3.0);
        }
        arena[pc.results + 3 * pc.scale] = num;
        arena[pc.results + 3 * pc.scale + 1] = den;
        arena[pc.results + 3 * pc.scale + 2] = aim;
    }
}
