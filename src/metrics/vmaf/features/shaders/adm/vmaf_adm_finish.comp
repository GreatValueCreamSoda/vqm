#version 450
#include "vmaf_adm_common.glsl"
layout(local_size_x = 1) in;
void main() {
    float num = 0.0, den = 0.0;
    for (uint s = 0; s < 4; ++s) {
        num += arena[pc.results + 2 * s];
        den += arena[pc.results + 2 * s + 1];
    }
    float limit = 1e-10 * float(pc.original_pixels) / 2073600.0;
    if (num < limit) num = 0.0;
    if (den < limit) den = 0.0;
    arena[pc.results + 8] = den == 0.0 ? 1.0 : num / den;
}
