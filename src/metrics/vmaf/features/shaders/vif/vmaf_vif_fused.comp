// Scale construction and FP32 statistic follow libvmaf vif.c:150-205 and
// vif_tools.c:35-82,198-312 at 4611e47a7330cd342498dcc130e1008efbeab6e4.
// The fused shared-memory schedule and reduction order are VQM's.

#version 450
#include "vmaf_vif_common.glsl"

#define VIF_TAPS ((1 << (4 - VIF_SCALE)) + 1)
#define VIF_RADIUS (VIF_TAPS / 2)
#define VIF_TILE_X (32 + 2 * VIF_RADIUS)
#define VIF_TILE_Y (16 + 2 * VIF_RADIUS)

layout(local_size_x = 16, local_size_y = 16) in;
// One source tile supplies both the vertical halo and the horizontal halo.
// Five vertical moment planes then feed the horizontal statistic pass without
// a scratch-plane round trip.
shared vec2 partial[256];
shared vec2 source_tile[VIF_TILE_X * VIF_TILE_Y];
shared float tile[5][16 * VIF_TILE_X];

float vif_log2(float x) {
    const uint bits = floatBitsToUint(x);
    const int exponent = int((bits & 0x7f800000u) >> 23u) - 127;
    const float rem = uintBitsToFloat((bits & 0x007fffffu) | 0x3f800000u) - 1.0;
    float v = -0.012671635276421;
    v = v * rem + 0.064841182402670;
    v = v * rem - 0.157048836463065;
    v = v * rem + 0.257167726303123;
    v = v * rem - 0.353800560300520;
    v = v * rem + 0.480131410397451;
    v = v * rem - 0.721314327952201;
    v = v * rem + 1.442694803896991;
    v *= rem;
    return float(exponent) + v;
}

vec2 vif_statistic(vec2 mu, vec3 moments) {
    const float eps = 1.0e-10;
    const float s1 = max(moments.x - mu.x * mu.x, 0.0);
    const float s2 = max(moments.y - mu.y * mu.y, 0.0);
    // Flat reference regions use the low-variance branch regardless of gain
    // or covariance. Skip the divisions and logarithms whose results it
    // replaces.
    if (s1 < 2.0) return vec2(1.0 - s2 * (4.0 / (255.0 * 255.0)), 1.0);
    const float s12 = moments.z - mu.x * mu.y;
    float gain = s12 / (s1 + eps);
    float residual = s2 - gain * s12;
    if (s2 < eps) {
        gain = 0.0;
        residual = 0.0;
    }
    if (gain < 0.0) {
        residual = s2;
        gain = 0.0;
    }
    residual = max(residual, eps);
    gain = min(gain, pc.gain_limit);
    float num = vif_log2(1.0 + (gain * gain * s1) / (residual + 2.0));
    float den = vif_log2(1.0 + s1 / 2.0);
    if (s12 < 0.0) num = 0.0;
    return vec2(num, den);
}

void main() {
    const uvec2 p = uvec2(
        gl_WorkGroupID.x * 32u + gl_LocalInvocationID.x,
        gl_WorkGroupID.y * 16u + gl_LocalInvocationID.y
    );
    const uint lx = gl_LocalInvocationID.x, ly = gl_LocalInvocationID.y;
    const uint lane = gl_LocalInvocationIndex;
    const int halo_x = min(VIF_RADIUS, int(pc.width) - 1);
    const int halo_y = min(VIF_RADIUS, int(pc.height) - 1);
    for (uint i = lane; i < VIF_TILE_X * VIF_TILE_Y; i += 256u) {
        const int tx = int(i % VIF_TILE_X), ty = int(i / VIF_TILE_X);
        const int raw_x = clamp(
            int(gl_WorkGroupID.x * 32u) + tx - VIF_RADIUS, -halo_x,
            int(pc.width) - 1 + halo_x
        );
        const int raw_y = clamp(
            int(gl_WorkGroupID.y * 16u) + ty - VIF_RADIUS, -halo_y,
            int(pc.height) - 1 + halo_y
        );
        const uint x = uint(vif_mirror(raw_x, int(pc.width)));
        const uint y = uint(vif_mirror(raw_y, int(pc.height)));
        const uint source = y * pc.width + x;
        source_tile[i] =
            vec2(arena[pc.reference + source], arena[pc.distorted + source]);
    }
    barrier();
    for (uint i = lane; i < 16u * VIF_TILE_X; i += 256u) {
        const uint tx = i % VIF_TILE_X, ty = i / VIF_TILE_X;
        vec2 means = vec2(0.0);
        vec3 moments = vec3(0.0);
        for (int k = 0; k < VIF_TAPS; ++k) {
            const vec2 value = source_tile[(ty + uint(k)) * VIF_TILE_X + tx];
            const float weight = vif_weight(k);
            means += weight * value;
            moments +=
                weight *
                vec3(value.x * value.x, value.y * value.y, value.x * value.y);
        }
        tile[0][i] = means.x;
        tile[1][i] = means.y;
        tile[2][i] = moments.x;
        tile[3][i] = moments.y;
        tile[4][i] = moments.z;
    }
    barrier();
    vec2 sums = vec2(0.0);
    if (p.y < pc.height) {
        vec2 mu0 = vec2(0.0), mu1 = vec2(0.0);
        vec3 moments0 = vec3(0.0), moments1 = vec3(0.0);
        const uint base = ly * VIF_TILE_X + 2u * lx;
        for (int k = 0; k <= VIF_TAPS; ++k) {
            const uint i = base + uint(k);
            const vec2 value = vec2(tile[0][i], tile[1][i]);
            const vec3 moment = vec3(tile[2][i], tile[3][i], tile[4][i]);
            if (k < VIF_TAPS) {
                const float weight = vif_weight(k);
                mu0 += weight * value;
                moments0 += weight * moment;
            }
            if (k > 0) {
                const float weight = vif_weight(k - 1);
                mu1 += weight * value;
                moments1 += weight * moment;
            }
        }
        const uint x = gl_WorkGroupID.x * 32u + 2u * lx;
        if (x < pc.width) sums += vif_statistic(mu0, moments0);
        if (x + 1u < pc.width) sums += vif_statistic(mu1, moments1);
    }
    partial[lane] = sums;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (lane < stride) partial[lane] += partial[lane + stride];
        barrier();
    }
    if (lane == 0u) {
        const uint groups_x = (pc.width + 31u) / 32u;
        const uint i = 2u * (gl_WorkGroupID.y * groups_x + gl_WorkGroupID.x);
        arena[pc.partials + i] = partial[0].x;
        arena[pc.partials + i + 1u] = partial[0].y;
    }
}
